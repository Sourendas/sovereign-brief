# Hugging Face token with Inference Providers permission (never commit the real value)
HF_TOKEN=

# OpenAI-compatible base URL (HF Inference Providers router by default)
# For sovereign/local vLLM: http://127.0.0.1:8000/v1
APERTUS_BASE_URL=https://router.huggingface.co/v1

# Public model id on Hugging Face (verified: swiss-ai/Apertus-v1.5-8B)
APERTUS_MODEL=swiss-ai/Apertus-v1.5-8B

# Optional: request timeout seconds
APERTUS_TIMEOUT=120

# If APERTUS_MODEL 404s on the HF router, retry this live Public AI id.
# Uses included free-account monthly credits only. Set to off to disable.
# Do not point this at a paid provider.
APERTUS_FALLBACK_MODEL=swiss-ai/Apertus-8B-Instruct-2509:publicai
